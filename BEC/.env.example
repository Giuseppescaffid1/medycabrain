# ── Django ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=medycabrain.messtudent.com,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.base
CORS_ALLOWED_ORIGINS=https://medycabrain.messtudent.com,http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://medycabrain_user:CHANGE_ME@localhost:5432/medycabrain
DB_SSL_REQUIRE=false

# ── LLM (HuggingFace Pro Inference API) ─────────────────────────────────
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── Whisper ─────────────────────────────────────────────────────────────
WHISPER_MODEL=small          # small | medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# ── Embeddings ──────────────────────────────────────────────────────────
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
