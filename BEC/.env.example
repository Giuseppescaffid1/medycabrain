# ── Django ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=medycabrain.messtudent.com,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.base
CORS_ALLOWED_ORIGINS=https://medycabrain.messtudent.com,http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://medycabrain_user:CHANGE_ME@localhost:5432/medycabrain
DB_SSL_REQUIRE=false

# ── LLM providers (fallback chain, first that answers wins) ─────────────
# Local-only by default: Ollama runs qwen2.5:7b-instruct-q4_K_M (quantized,
# zero cost, good Italian). HF is DORMANT — it is not in the order, so it is
# never called. To re-enable HF (e.g. after refilling credits) set:
#   LLM_PROVIDER_ORDER=ollama,hf
LLM_PROVIDER_ORDER=ollama
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Provider remoti, IN ORDINE DI PRIORITÀ. Il primo che risponde vince; uno
# senza credito o con la chiave morta viene saltato e risponde il successivo.
# Aggiungi "fast" davanti all'ordine qui sopra per attivarli:
#   LLM_PROVIDER_ORDER=fast,ollama
LLM_ENDPOINTS=anthropic,groq

# Anthropic: chiave a consumo, https://console.anthropic.com/settings/keys
# Il dialetto "anthropic" viene riconosciuto dall'indirizzo e usa /v1/messages.
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx
LLM_ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5
LLM_ANTHROPIC_MODEL_BULK=claude-sonnet-5

# Groq: gratuito, senza carta — https://console.groq.com/keys
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
LLM_GROQ_MODEL_ANALYSIS=openai/gpt-oss-120b
LLM_GROQ_MODEL_BULK=openai/gpt-oss-20b
# Riserve sullo stesso provider: i piani gratuiti limitano i token al giorno
# PER MODELLO, quindi un modello fratello ha ancora budget suo.
LLM_GROQ_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# ── Batch: stessi modelli, meta' prezzo, risposte entro 24h ─────────────
# L'analisi notturna non ha fretta. BATCH_ENABLED=0 la riporta tutta alle
# chiamate immediate.
BATCH_ENABLED=1
BATCH_MODEL=claude-sonnet-5
BATCH_MAX_REQUESTS=2000

# Trascrizione audio: endpoint separato di proposito — un gateway di solo
# testo non espone /audio/transcriptions e ogni richiesta finirebbe in 404,
# ricadendo sul modello locale che storpia "ormoni bioidentici".
FAST_LLM_BASE_URL=https://api.groq.com/openai/v1
FAST_LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Whisper ─────────────────────────────────────────────────────────────
WHISPER_MODEL=small          # small | medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# ── Embeddings ──────────────────────────────────────────────────────────
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
