# /etc/systemd/system/medycabrain-backend.service
# Install: sudo cp deploy/medycabrain-backend.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now medycabrain-backend
[Unit]
Description=medycabrain BEC (Gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=giuseppe
Group=giuseppe
WorkingDirectory=/home/giuseppe/projects/medycabrain/BEC
EnvironmentFile=/home/giuseppe/projects/medycabrain/BEC/.env
# The chat streams its answer, so a request occupies a slot for ~30s. Threads,
# not workers, are the axis to grow: threads share the embedding model and the
# retrieval index cache, workers each keep their own copy.
#
# --worker-class is stated even though --threads implies it. It used to be
# implicit, and anyone "tuning" --threads back to 1 would silently drop to the
# sync worker, where two concurrent answers block the whole backend.
#
# --graceful-timeout matters because --max-requests recycles workers: the
# default 30s lands exactly on the length of an answer, so a recycled worker
# would truncate a reply mid-sentence, rarely and unreproducibly.
ExecStart=/home/giuseppe/projects/medycabrain/BEC/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8010 \
    --worker-class gthread \
    --workers 3 --threads 8 --timeout 300 --graceful-timeout 120 \
    --max-requests 1000 --max-requests-jitter 50 \
    --access-logfile /home/giuseppe/projects/medycabrain/BEC/logs/access.log \
    --error-logfile /home/giuseppe/projects/medycabrain/BEC/logs/error.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
